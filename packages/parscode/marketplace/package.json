{
  "name": "@parscode/marketplace",
  "version": "0.2.2-rc.1",
  "description": "ParsCode plugin marketplace with registry API, auto-install, and management UI",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./registry-api.yaml": "./registry-api.yaml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/client.js",
    "lib/types/client/**/*.d.ts",
    "registry-api.yaml",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -b",
    "mock-registry": "tsx scripts/mock-registry.ts"
  },
  "dependencies": {
    "@parscode/brand": "workspace:*",
    "@parscode/theme": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-plugin-manager": "workspace:*",
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-official-bundles": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*",
    "execa": "^10.0.1",
    "semver": "^7.8.5",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@parscode/marketplace": "workspace:*",
    "typescript": "^6.0.3",
    "tsdown": "^0.22.2",
    "@types/semver": "^7.8.0",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-plugin-manager", "@parscode/theme"]
    }
  }
}